{
  "name": "tempo-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "node scripts/lint.cjs",
    "typecheck": "tsc --noEmit",
    "build:android-debug": "node scripts/android-build.cjs",
    "build:android-release": "node scripts/android-build.cjs release",
