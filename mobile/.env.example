# Copy to .env and fill. Same Supabase project as web (tempo).
# Pure React Native CLI uses react-native-config (no EXPO_PUBLIC_ prefix).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Web API base — your deployed tempo web (Next.js) or local dev.
# Android emulator reaches host via 10.0.2.2; physical device uses LAN IP, e.g. http://192.168.1.10:3100
TEMPO_API_URL=http://10.0.2.2:3100
