// Tempo — production schema (Construction Notebook §7-8)
// Prisma runs only on the server. Client code never imports this.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled runtime connection
  directUrl = env("DIRECT_URL")     // direct connection, migrations only
}

enum MembershipRole {
  owner
  admin
  member
  viewer
}

enum EventStatus {
  confirmed
  tentative
  cancelled
}

enum ReminderChannel {
  in_app
  email
}

/// Profile row linked 1:1 to the Supabase Auth user (auth.users.id).
model UserProfile {
  id              String   @id // matches Supabase auth.users.id
  displayName     String   @map("display_name")
  avatarUrl       String?  @map("avatar_url")
  locale          String   @default("en-US")
  defaultTimezone String   @default("UTC") @map("default_timezone")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assistantPolicy AssistantPolicy?
  assistantPlans AssistantPlan[]
  ownedWorkspaces Workspace[]  @relation("WorkspaceOwner")
  memberships     Membership[]
  createdEvents   Event[]      @relation("EventCreator")
  attendances     Attendee[]
  reminders       Reminder[]
  auditLogs       AuditLog[]
  notifications Notification[]

  @@map("user_profiles")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  owner     UserProfile @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assistantPlans AssistantPlan[]
  tasks       Task[]
  memberships Membership[]
  calendars   Calendar[]
  auditLogs   AuditLog[]
  notifications Notification[]

  @@index([ownerId])
  @@map("workspaces")
}

model Membership {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  userId      String         @map("user_id")
  role        MembershipRole @default(member)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Calendar {
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  color       String   // token name, e.g. "work" | "personal" | hex
  isDefault   Boolean  @default(false) @map("is_default")
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    Event[]

  @@index([workspaceId])
  @@map("calendars")
}

model Event {
  id               String      @id @default(cuid())
  calendarId       String      @map("calendar_id")
  createdById      String      @map("created_by_id")
  title            String
  description      String?
  location         String?
  startAt          DateTime    @map("start_at") @db.Timestamptz(3) // instant + timezone (P6 fix)
  endAt            DateTime    @map("end_at") @db.Timestamptz(3)
  timezone         String      // IANA zone the event was authored in, e.g. "America/Toronto"
  allDay           Boolean     @default(false) @map("all_day")
  color            String?
  visibility       String @default("default")
  availability     String @default("busy")
  eventType        String @default("event") @map("event_type")
  conferenceUrl    String? @map("conference_url")
  status           EventStatus @default(confirmed)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3) // soft delete, powers Undo

  /** Free‑form tags / categories for organizing events */
  labels          String[]    @default([]) @map("labels")
  /** Numeric priority: 1 = low, 2 = medium (default), 3 = high */
  priority         Int         @default(2) @map("priority")

  calendar        Calendar         @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  createdBy       UserProfile      @relation("EventCreator", fields: [createdById], references: [id])
  recurrenceRule  RecurrenceRule?
  attendees       Attendee[]
  reminders       Reminder[]
  notifications Notification[]

  @@index([calendarId, startAt, endAt])
  @@index([startAt])
  @@index([createdById])
  @@map("events")
}

model RecurrenceRule {
  id        String   @id @default(cuid())
  eventId   String   @unique @map("event_id")
  rrule     String   // RFC 5545 RRULE string
  timezone  String
  dtstart   DateTime @db.Timestamptz(3)
  until     DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("recurrence_rules")
}

model Attendee {
  inviteTokenHash String? @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz(3)
  id             String   @id @default(cuid())
  eventId        String   @map("event_id")
  userId         String?  @map("user_id") // null for external, email-only invitees
  email          String
  displayName    String?  @map("display_name")
  responseStatus String   @default("needs_action") @map("response_status")
  isOptional     Boolean  @default(false) @map("is_optional")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  UserProfile? @relation(fields: [userId], references: [id])

  @@unique([eventId, email])
  @@index([userId])
  @@map("attendees")
}

model Reminder {
  id            String          @id @default(cuid())
  eventId       String          @map("event_id")
  userId        String          @map("user_id")
  minutesBefore Int             @map("minutes_before")
  channel       ReminderChannel @default(in_app)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  UserProfile @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@map("reminders")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  actorUserId String   @map("actor_user_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  metadata    Json?    @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     UserProfile @relation(fields: [actorUserId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  type        String   // event_reminder | event_invite | event_update | system
  title       String
  body        String?
  eventId     String?  @map("event_id")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event     Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("notifications")
}

model Task {
  id String @id @default(cuid())
  workspaceId String @map("workspace_id")
  userId String @map("user_id")
  title String
  notes String @default("")
  listName String @default("My tasks") @map("list_name")
  startAt DateTime? @map("start_at") @db.Timestamptz(3)
  endAt DateTime? @map("end_at") @db.Timestamptz(3)
  dueAt DateTime? @map("due_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  @@index([workspaceId,userId])
  @@map("tasks")
}

model DeliveryJob {
  id String @id @default(cuid())
  dedupeKey String @unique @map("dedupe_key")
  payload Json?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([deliveredAt,nextAttemptAt])
  @@map("delivery_jobs")
}

model AssistantPolicy {
 userId String @id @map("user_id")
 canRead Boolean @default(false) @map("can_read")
 canCreateEvents Boolean @default(false) @map("can_create_events")
 canEditEvents Boolean @default(false) @map("can_edit_events")
 canDeleteEvents Boolean @default(false) @map("can_delete_events")
 canCreateCalendars Boolean @default(false) @map("can_create_calendars")
 canManageCalendars Boolean @default(false) @map("can_manage_calendars")
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 user UserProfile @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@map("assistant_policies")
}
model AssistantPlan {
 id String @id @default(cuid())
 userId String @map("user_id")
 workspaceId String @map("workspace_id")
 actions Json
 results Json?
 state String @default("pending")
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 user UserProfile @relation(fields:[userId],references:[id],onDelete:Cascade)
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 @@index([userId,createdAt])
 @@map("assistant_plans")
}
