# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Current naming (preferred): publishable key + secret key (Notebook v2 §12)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback (still accepted): ANON_KEY / SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI — Groq (free) or OpenAI-compatible. Key is user-owned, never committed. Prefix is shown before the key in Settings.
NEXT_PUBLIC_GROQ_KEY_PREFIX=gsk_
GROQ_API_KEY=
# Alternative free provider (OpenRouter, etc.)
AI_API_KEY_PREFIX=
AI_API_KEY=

# Site URL used for sitemap/robots/canonical/OG (no trailing slash). Set to your production domain when publishing.
NEXT_PUBLIC_SITE_URL=https://agenda.example.com

# Authentication and database access are required; no demo bypass is available.

# Prisma — pooled connection for the running app (Supabase "Connection pooling" URI)
# Never expose DATABASE_URL / DIRECT_URL / SUPABASE_SECRET_KEY to the client bundle.
DATABASE_URL=
# Prisma CLI — direct connection, used only for migrate/introspect
DIRECT_URL=

# Background in-app reminder endpoint. Use a random secret of at least 32 characters.
# Configure your own scheduler to GET /api/jobs/reminders every minute with its Bearer token.
CRON_SECRET=
